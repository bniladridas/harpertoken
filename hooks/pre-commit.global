#!/bin/bash

# Global pre-commit hook that matches the project's specific configuration

# ANSI color codes
BLUE="\033[1;34m"
YELLOW="\033[1;33m"
GREEN="\033[1;32m"
RED="\033[1;31m"
RESET="\033[0m"

echo -e "${BLUE}Running pre-commit checks...${RESET}"

# Check if pre-commit is installed
if ! command -v pre-commit &> /dev/null; then
    echo -e "${RED}pre-commit is not installed. Please install it with:${RESET}"
    echo -e "${BLUE}   pip install pre-commit${RESET}"
    exit 1
fi

# Get the project root directory
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

# If we're not in a git repository, exit
if [ -z "$PROJECT_ROOT" ]; then
    echo -e "${RED}Not in a git repository${RESET}"
    exit 1
fi

# Check for project-specific config
if [ -f "$PROJECT_ROOT/.pre-commit-config.yaml" ]; then
    echo -e "${BLUE}Using project's pre-commit configuration...${RESET}"
    CONFIG="$PROJECT_ROOT/.pre-commit-config.yaml"
else
    echo -e "${YELLOW}No project-specific pre-commit config found. Using global defaults...${RESET}"
    # Create a temporary config file with the same checks as your project
    TMP_CONFIG="$(mktemp)"
    cat > "$TMP_CONFIG" << 'EOL'
repos:
  # Python Formatting
  - repo: https://github.com/psf/black
    rev: 23.12.1
    hooks:
      - id: black
        name: black
        description: "Black: The uncompromising Python code formatter"
        entry: black
        language: python
        types: [python]
        require_serial: true
        args: [--line-length=127, --safe, --quiet]

  # Import sorting
  - repo: https://github.com/pycqa/isort
    rev: 5.13.2
    hooks:
      - id: isort
        name: isort (python)
        description: "Sorts Python imports"
        entry: isort --profile black --line-length=127
        language: python
        types: [python]
        require_serial: true

  # Python Linting
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.1.13
    hooks:
      - id: ruff
        args: [--fix, --exit-non-zero-on-fix]
      - id: ruff-format
        args: [--line-length=127]

  # YAML Linting
  - repo: https://github.com/adrienverge/yamllint.git
    rev: v1.33.0
    hooks:
      - id: yamllint
        name: yamllint
        description: This hook runs yamllint.
        entry: yamllint
        language: python
        types: [yaml]
        args: [--strict]
        additional_dependencies: [yamllint]

  # Basic file checks
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v4.5.0
    hooks:
      - id: check-yaml
        args: [--allow-multiple-documents, --unsafe]
      - id: end-of-file-fixer
        exclude: \.min\.(js|css)$
      - id: trailing-whitespace
        args: []
EOL
    CONFIG="$TMP_CONFIG"
    trap 'rm -f "$TMP_CONFIG"' EXIT
fi

# Run pre-commit with the appropriate config
echo -e "${BLUE}Running pre-commit checks...${RESET}"
pre-commit run --config "$CONFIG" --hook-stage=pre-commit --all-files
EXIT_CODE=$?

if [ $EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}All pre-commit checks passed!${RESET}"
else
    echo -e "${RED}Pre-commit checks failed. Please fix the issues and try again.${RESET}"
fi

exit $EXIT_CODE