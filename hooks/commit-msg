#!/bin/bash

# Enforce conventional commit standards
# - Types: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert
# - Lowercase
# - First line ≤60 characters

# ANSI color codes
RED="\033[1;31m"
RESET="\033[0m"

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")
first_line=$(echo "$commit_msg" | head -n1)

# Check length
if [ ${#first_line} -gt 60 ]; then
    echo -e "${RED}Error: Commit message first line exceeds 60 characters${RESET}"
    exit 1
fi

# Check lowercase
if [[ "$first_line" =~ [A-Z] ]]; then
    echo -e "${RED}Error: Commit message must be all lowercase${RESET}"
    exit 1
fi

# Check conventional commit format
if ! [[ "$first_line" =~ ^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert): ]]; then
    echo -e "${RED}Error: Commit message must start with a conventional commit type (e.g., feat:, fix:, etc.)${RESET}"
    exit 1
fi

exit 0